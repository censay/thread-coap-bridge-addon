#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the Thread CoAP Bridge service
# ==============================================================================

bashio::log.info "Starting Thread CoAP Bridge..."

# Debug shell mode
if bashio::config.has_value 'debug_shell' && bashio::config.true 'debug_shell'; then
    bashio::log.warning "==============================="
    bashio::log.warning "DEBUG SHELL ENABLED"
    bashio::log.warning "Use SSH & Web Terminal -> Web Terminal"
    bashio::log.warning "Type commands to debug CoAP/Thread"
    bashio::log.warning "==============================="
    exec /bin/bash
fi

# Check if MQTT service is available
if ! bashio::services.available "mqtt"; then
    bashio::log.fatal "MQTT service not available!"
    bashio::exit.nok "Please install and start the Mosquitto broker add-on"
fi

# Get MQTT service details from Home Assistant Supervisor
MQTT_HOST=$(bashio::services "mqtt" "host")
MQTT_PORT=$(bashio::services "mqtt" "port")
MQTT_USER=$(bashio::services "mqtt" "username")
MQTT_PASS=$(bashio::services "mqtt" "password")

bashio::log.info "MQTT Broker: ${MQTT_HOST}:${MQTT_PORT}"

# Check Thread interface exists and show diagnostics
if ip link show wpan0 &> /dev/null; then
    bashio::log.info "Thread interface wpan0: UP"
    bashio::log.info "wpan0 IPv6 addresses:"
    ip -6 addr show wpan0 | grep inet6 | while read line; do
        bashio::log.info "  ${line}"
    done
else
    bashio::log.warning "Thread interface wpan0 not found!"
    bashio::log.warning "Make sure OpenThread Border Router add-on is running"
fi

# Export environment variables for the application
export MQTT_HOST="${MQTT_HOST}"
export MQTT_PORT="${MQTT_PORT}"
export MQTT_USER="${MQTT_USER}"
export MQTT_PASS="${MQTT_PASS}"

# Show configuration
bashio::log.info "Configuration loaded:"
bashio::log.info "  Discovery interval: $(bashio::config 'discovery_interval')s"
bashio::log.info "  Log level: $(bashio::config 'log_level')"
bashio::log.info "  Thread interface: $(bashio::config 'thread_interface')"
bashio::log.info "  Offline threshold: $(bashio::config 'offline_threshold_polls') polls"
bashio::log.info "  Cleanup after: $(bashio::config 'cleanup_after_hours') hours"

# Remove old database on first run with new schema
# The app will create a new one with the correct schema automatically
if [ -f "/data/devices.db" ] && [ ! -f "/data/.schema_updated" ]; then
    bashio::log.warning "Removing old database (will be recreated with new schema)"
    rm -f /data/devices.db
    touch /data/.schema_updated
    bashio::log.info "Database will be recreated - devices will need to be rediscovered"
fi

# Run the Python application
cd /app
exec python3 main.py
